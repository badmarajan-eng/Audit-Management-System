{
  "entities": {
    "UserAccount": {
      "title": "UserAccount",
      "description": "Authenticated ERP staff account with assigned RBAC role.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "format": "email", "maxLength": 200 },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "role": { "type": "string", "enum": ["salesman", "admin", "supervisor", "accountant", "owner"] },
        "assignedSalesmanTag": { "type": "string", "maxLength": 80 },
        "active": { "type": "boolean" },
        "orgId": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["uid", "email", "displayName", "role", "active", "orgId"]
    },
    "CompanySettings": {
      "title": "CompanySettings",
      "description": "Company profile, GSTIN, valuation method, and variance threshold.",
      "type": "object",
      "properties": {
        "companyName": { "type": "string", "minLength": 2, "maxLength": 160 },
        "legalName": { "type": "string", "minLength": 2, "maxLength": 160 },
        "gstin": { "type": "string", "minLength": 15, "maxLength": 15, "pattern": "^[0-9]{2}[A-Z]{5}[0-9]{4}[A-Z]{1}[1-9A-Z]{1}Z[0-9A-Z]{1}$" },
        "address": { "type": "string", "maxLength": 300 },
        "state": { "type": "string", "maxLength": 80 },
        "stateCode": { "type": "string", "maxLength": 4 },
        "financialYear": { "type": "string", "maxLength": 16 },
        "valuationMethod": { "type": "string", "enum": ["WEIGHTED_AVERAGE", "FIFO"] },
        "varianceTolerancePct": { "type": "number" },
        "invoiceCounter": { "type": "number" },
        "orgId": { "type": "string", "maxLength": 64 }
      },
      "required": ["companyName", "gstin", "state", "financialYear", "valuationMethod", "varianceTolerancePct", "orgId"]
    },
    "Product": {
      "title": "Product",
      "description": "Packaged finished food SKU produced and sold.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "code": { "type": "string", "maxLength": 32 },
        "name": { "type": "string", "minLength": 2, "maxLength": 120 },
        "category": { "type": "string", "enum": ["Savouries", "Mixtures", "Chips", "Sweets"] },
        "sku": { "type": "string", "maxLength": 40 },
        "packSize": { "type": "string", "maxLength": 32 },
        "sellingPrice": { "type": "number" },
        "gstRate": { "type": "number" },
        "hsnCode": { "type": "string", "maxLength": 16 },
        "availableStock": { "type": "number" },
        "reorderLevel": { "type": "number" },
        "status": { "type": "string", "enum": ["ACTIVE", "INACTIVE"] },
        "imageUrl": { "type": "string", "maxLength": 300 },
        "orgId": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "code", "name", "category", "sku", "packSize", "sellingPrice", "gstRate", "hsnCode", "availableStock", "status", "orgId"]
    },
    "Material": {
      "title": "Material",
      "description": "Raw ingredient or packaging material tracked in stock ledger.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "code": { "type": "string", "maxLength": 32 },
        "name": { "type": "string", "minLength": 2, "maxLength": 120 },
        "category": { "type": "string", "enum": ["RAW_MATERIAL", "PACKAGING"] },
        "unit": { "type": "string", "enum": ["kg", "g", "litre", "ml", "pieces", "packets", "cartons"] },
        "availableStock": { "type": "number" },
        "reorderLevel": { "type": "number" },
        "weightedAvgCost": { "type": "number" },
        "lastPurchaseRate": { "type": "number" },
        "status": { "type": "string", "enum": ["ACTIVE", "INACTIVE"] },
        "orgId": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "code", "name", "category", "unit", "availableStock", "weightedAvgCost", "status", "orgId"]
    },
    "Customer": {
      "title": "Customer",
      "description": "Retailer or Distributor buyer record with GSTIN and state.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "code": { "type": "string", "maxLength": 32 },
        "name": { "type": "string", "minLength": 2, "maxLength": 140 },
        "customerType": { "type": "string", "enum": ["Retailer", "Distributor"] },
        "phone": { "type": "string", "maxLength": 24 },
        "email": { "type": "string", "maxLength": 160 },
        "gstin": { "type": "string", "maxLength": 15 },
        "billingAddress": { "type": "string", "maxLength": 300 },
        "shippingAddress": { "type": "string", "maxLength": 300 },
        "state": { "type": "string", "maxLength": 80 },
        "assignedSalesman": { "type": "string", "maxLength": 80 },
        "outstandingBalance": { "type": "number" },
        "status": { "type": "string", "enum": ["ACTIVE", "INACTIVE"] },
        "orgId": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "code", "name", "customerType", "state", "outstandingBalance", "status", "orgId"]
    },
    "Supplier": {
      "title": "Supplier",
      "description": "Raw material and packaging vendor record.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "code": { "type": "string", "maxLength": 32 },
        "name": { "type": "string", "minLength": 2, "maxLength": 140 },
        "phone": { "type": "string", "maxLength": 24 },
        "email": { "type": "string", "maxLength": 160 },
        "gstin": { "type": "string", "maxLength": 15 },
        "address": { "type": "string", "maxLength": 300 },
        "state": { "type": "string", "maxLength": 80 },
        "status": { "type": "string", "enum": ["ACTIVE", "INACTIVE"] },
        "orgId": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "code", "name", "state", "status", "orgId"]
    },
    "BOM": {
      "title": "BOM",
      "description": "Versioned Bill of Materials for one production batch.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "code": { "type": "string", "maxLength": 40 },
        "productId": { "type": "string", "maxLength": 64 },
        "productName": { "type": "string", "maxLength": 120 },
        "version": { "type": "string", "maxLength": 24 },
        "expectedOutput": { "type": "number" },
        "isActive": { "type": "boolean" },
        "orgId": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "code", "productId", "version", "expectedOutput", "isActive", "orgId"]
    },
    "Purchase": {
      "title": "Purchase",
      "description": "Material purchase and stock receipt transaction.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "purchaseNumber": { "type": "string", "maxLength": 40 },
        "purchaseDate": { "type": "string", "maxLength": 24 },
        "supplierId": { "type": "string", "maxLength": 64 },
        "materialId": { "type": "string", "maxLength": 64 },
        "quantity": { "type": "number" },
        "rate": { "type": "number" },
        "totalValue": { "type": "number" },
        "orgId": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "purchaseNumber", "purchaseDate", "supplierId", "materialId", "quantity", "rate", "totalValue", "orgId"]
    },
    "ProductionRun": {
      "title": "ProductionRun",
      "description": "Manufacturing batch run with actual consumption, yield variance, and costing.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "runNumber": { "type": "string", "maxLength": 40 },
        "productionDate": { "type": "string", "maxLength": 24 },
        "productId": { "type": "string", "maxLength": 64 },
        "bomId": { "type": "string", "maxLength": 64 },
        "batchSize": { "type": "number" },
        "expectedOutput": { "type": "number" },
        "goodOutput": { "type": "number" },
        "damagedPouches": { "type": "number" },
        "yieldVariancePct": { "type": "number" },
        "totalProductionCost": { "type": "number" },
        "costPerPacket": { "type": "number" },
        "orgId": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "runNumber", "productionDate", "productId", "bomId", "batchSize", "expectedOutput", "goodOutput", "totalProductionCost", "costPerPacket", "orgId"]
    },
    "SalesOrder": {
      "title": "SalesOrder",
      "description": "Salesman order moving through verification, approval, invoicing, and dispatch.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "orderNumber": { "type": "string", "maxLength": 40 },
        "orderDate": { "type": "string", "maxLength": 24 },
        "customerId": { "type": "string", "maxLength": 64 },
        "salesmanName": { "type": "string", "maxLength": 80 },
        "status": { "type": "string", "enum": ["Draft", "Submitted", "Approved", "Rejected", "Invoiced", "Partially Dispatched", "Dispatched", "Cancelled"] },
        "taxableTotal": { "type": "number" },
        "grandTotal": { "type": "number" },
        "orgId": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "orderNumber", "orderDate", "customerId", "status", "taxableTotal", "grandTotal", "orgId"]
    },
    "Invoice": {
      "title": "Invoice",
      "description": "Posted GST tax invoice with intra-state CGST+SGST or interstate IGST.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "invoiceNumber": { "type": "string", "maxLength": 40 },
        "financialYear": { "type": "string", "maxLength": 16 },
        "invoiceDate": { "type": "string", "maxLength": 24 },
        "orderId": { "type": "string", "maxLength": 64 },
        "customerId": { "type": "string", "maxLength": 64 },
        "supplyType": { "type": "string", "enum": ["INTRA_STATE", "INTER_STATE"] },
        "taxableTotal": { "type": "number" },
        "cgstTotal": { "type": "number" },
        "sgstTotal": { "type": "number" },
        "igstTotal": { "type": "number" },
        "grandTotal": { "type": "number" },
        "paidAmount": { "type": "number" },
        "outstandingAmount": { "type": "number" },
        "status": { "type": "string", "enum": ["POSTED", "PARTIAL_PAID", "PAID", "CANCELLED_BY_CN"] },
        "orgId": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "invoiceNumber", "invoiceDate", "orderId", "customerId", "supplyType", "grandTotal", "outstandingAmount", "status", "orgId"]
    },
    "Dispatch": {
      "title": "Dispatch",
      "description": "Goods dispatch or customer return movement against an order/invoice.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "dispatchNumber": { "type": "string", "maxLength": 40 },
        "dispatchDate": { "type": "string", "maxLength": 24 },
        "orderId": { "type": "string", "maxLength": 64 },
        "type": { "type": "string", "enum": ["DISPATCH", "RETURN"] },
        "orgId": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "dispatchNumber", "dispatchDate", "orderId", "type", "orgId"]
    },
    "Payment": {
      "title": "Payment",
      "description": "Customer receipt linked to a GST invoice.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "paymentNumber": { "type": "string", "maxLength": 40 },
        "paymentDate": { "type": "string", "maxLength": 24 },
        "invoiceId": { "type": "string", "maxLength": 64 },
        "customerId": { "type": "string", "maxLength": 64 },
        "amount": { "type": "number" },
        "paymentMode": { "type": "string", "enum": ["NEFT", "UPI", "Cheque", "Cash", "RTGS"] },
        "orgId": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "paymentNumber", "paymentDate", "invoiceId", "customerId", "amount", "paymentMode", "orgId"]
    },
    "StockLedgerEntry": {
      "title": "StockLedgerEntry",
      "description": "Immutable double-entry-style inventory stock movement record.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "itemId": { "type": "string", "maxLength": 64 },
        "itemName": { "type": "string", "maxLength": 120 },
        "itemCategory": { "type": "string", "enum": ["RAW_MATERIAL", "PACKAGING", "FINISHED_GOOD"] },
        "movementType": { "type": "string", "enum": ["OPENING", "PURCHASE", "PRODUCTION_ISSUE", "PRODUCTION_OUTPUT", "PRODUCTION_DAMAGE", "SALE_DISPATCH", "SALES_RETURN", "ADJUSTMENT"] },
        "quantityDelta": { "type": "number" },
        "balanceAfter": { "type": "number" },
        "date": { "type": "string", "maxLength": 24 },
        "sourceDocument": { "type": "string", "maxLength": 64 },
        "orgId": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "itemId", "itemCategory", "movementType", "quantityDelta", "balanceAfter", "date", "sourceDocument", "orgId"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Immutable audit log of critical ERP mutations.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "action": { "type": "string", "maxLength": 80 },
        "entityType": { "type": "string", "maxLength": 64 },
        "entityId": { "type": "string", "maxLength": 64 },
        "summary": { "type": "string", "maxLength": 300 },
        "userId": { "type": "string", "maxLength": 128 },
        "userRole": { "type": "string", "maxLength": 32 },
        "orgId": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "action", "entityType", "entityId", "summary", "userId", "orgId"]
    }
  },
  "firestore": {
    "/users/{userId}": { "schema": { "$ref": "#/entities/UserAccount" }, "description": "Staff user accounts and RBAC roles." },
    "/settings/{settingId}": { "schema": { "$ref": "#/entities/CompanySettings" }, "description": "Company configuration and counters." },
    "/products/{productId}": { "schema": { "$ref": "#/entities/Product" }, "description": "Finished goods products." },
    "/materials/{materialId}": { "schema": { "$ref": "#/entities/Material" }, "description": "Raw and packaging materials." },
    "/customers/{customerId}": { "schema": { "$ref": "#/entities/Customer" }, "description": "Customer directory." },
    "/suppliers/{supplierId}": { "schema": { "$ref": "#/entities/Supplier" }, "description": "Supplier directory." },
    "/boms/{bomId}": { "schema": { "$ref": "#/entities/BOM" }, "description": "Bill of Materials definitions." },
    "/purchases/{purchaseId}": { "schema": { "$ref": "#/entities/Purchase" }, "description": "Material purchase receipts." },
    "/productionRuns/{runId}": { "schema": { "$ref": "#/entities/ProductionRun" }, "description": "Production batch runs." },
    "/orders/{orderId}": { "schema": { "$ref": "#/entities/SalesOrder" }, "description": "Sales orders." },
    "/invoices/{invoiceId}": { "schema": { "$ref": "#/entities/Invoice" }, "description": "Posted GST tax invoices." },
    "/dispatches/{dispatchId}": { "schema": { "$ref": "#/entities/Dispatch" }, "description": "Goods dispatch and return notes." },
    "/payments/{paymentId}": { "schema": { "$ref": "#/entities/Payment" }, "description": "Customer payment receipts." },
    "/stockLedger/{entryId}": { "schema": { "$ref": "#/entities/StockLedgerEntry" }, "description": "Immutable stock movement ledger." },
    "/auditLogs/{logId}": { "schema": { "$ref": "#/entities/AuditLog" }, "description": "Immutable ERP audit logs." }
  }
}
